{
  "schemaVersion": 1,
  "id": "raknetify",
  "version": "${version}",

  "name": "Raknetify2 (Fabric)",
  "description": "A Fabric mod that allows using RakNet as Minecraft networking backend. ",
  "authors": [
    "ishland"
  ],
  "contact": {
    "sources": "https://github.com/pjscruggs/raknetify2",
    "issues": "https://github.com/pjscruggs/raknetify2/issues"
  },

  "license": "MIT",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ishland.raknetify.fabric.RaknetifyFabric"
    ],
    "preLaunch": [
      "com.ishland.raknetify.fabric.RaknetifyFabric"
    ]
  },

  "accessWidener" : "raknetify-fabric.accesswidener",

  "mixins": [
    "raknetify-fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": "${loader}",
    "minecraft": ["${minecraft}", "26.4-alpha.7"],
    "java": "${java}"
  },
  "suggests": {
  }
}
